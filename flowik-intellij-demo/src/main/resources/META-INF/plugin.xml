<idea-plugin>
    <id>org.example.flowik-intellij-demo</id>
    <name>Flowik Demo</name>
    <vendor>JetBrains</vendor>

    <description><![CDATA[
        Showcases Flowik MobX for IntelliJ Platform plugins.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="MyToolWindow" factoryClass="org.example.MyToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
    </extensions>
</idea-plugin>
